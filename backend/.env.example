# Database configuration
DATABASE_URL=jdbc:postgresql://<host>:<port>/<database_name>
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# JWT configuration (minimally 256 bits/32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Mail Server configuration for OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@yourdomain.com

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Groq AI (Practice Center)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini AI (Answer Evaluator) - get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Supabase Storage (Answer Evaluator file uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_NAME=answer-submissions
